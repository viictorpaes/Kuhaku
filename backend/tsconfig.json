{
  "extends": "../tsconfig.base.json",
  "compilerOptions": 
  {
    "module": "Node16",
    "moduleResolution": "node16",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2022",
    "incremental": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
